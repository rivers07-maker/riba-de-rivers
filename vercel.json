{
  "version": 2,
  "builds": [
    {
      "src": "api/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "installCommand": "pip install -r requirements.txt"
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "css/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "js/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/wsgi.py"
    },
    {
      "src": "/success",
      "dest": "/public/success.html"
    },
    {
      "src": "/validate-coupon",
      "dest": "api/wsgi.py"
    },
    {
      "src": "/process_booking_payment",
      "dest": "api/wsgi.py"
    },
    {
      "src": "/payment_event_callback",
      "dest": "api/wsgi.py"
    },
    {
      "src": "/contact",
      "dest": "api/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}